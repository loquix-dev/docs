---
interface Props {
	label?: string;
	compact?: boolean;
	tall?: boolean;
}

const { label = 'Preview', compact = false, tall = false } = Astro.props;
---

<div class:list={['loquix-preview', { 'loquix-preview--compact': compact, 'loquix-preview--tall': tall }]}>
	<div class="loquix-preview__bar">
		<span class="loquix-preview__label">{label}</span>
		<span class="loquix-preview__status"><i></i> Live component</span>
	</div>
	<div class="loquix-preview__canvas">
		<slot />
	</div>
</div>

<script>
	import '@loquix/core/define/define-action-button';
	import '@loquix/core/define/define-action-copy';
	import '@loquix/core/define/define-action-edit';
	import '@loquix/core/define/define-action-feedback';
	import '@loquix/core/define/define-attachment-chip';
	import '@loquix/core/define/define-caveat-notice';
	import '@loquix/core/define/define-citation-popover';
	import '@loquix/core/define/define-confidence-indicator';
	import '@loquix/core/define/define-disagreement-marker';
	import '@loquix/core/define/define-disclosure-badge';
	import '@loquix/core/define/define-chat-container';
	import '@loquix/core/define/define-chat-header';
	import '@loquix/core/define/define-chat-composer';
	import '@loquix/core/define/define-composer-toolbar';
	import '@loquix/core/define/define-drop-zone';
	import '@loquix/core/define/define-follow-up-suggestions';
	import '@loquix/core/define/define-generation-controls';
	import '@loquix/core/define/define-message-actions';
	import '@loquix/core/define/define-message-avatar';
	import '@loquix/core/define/define-message-attachments';
	import '@loquix/core/define/define-message-content';
	import '@loquix/core/define/define-message-item';
	import '@loquix/core/define/define-message-list';
	import '@loquix/core/define/define-mode-selector';
	import '@loquix/core/define/define-model-selector';
	import '@loquix/core/define/define-prompt-input';
	import '@loquix/core/define/define-reasoning-block';
	import '@loquix/core/define/define-search-answer';
	import '@loquix/core/define/define-search-dialog';
	import '@loquix/core/define/define-search-footer';
	import '@loquix/core/define/define-search-input';
	import '@loquix/core/define/define-search-panel';
	import '@loquix/core/define/define-search-result';
	import '@loquix/core/define/define-search-results';
	import '@loquix/core/define/define-search-sources';
	import '@loquix/core/define/define-source-list';
	import '@loquix/core/define/define-tool-call';
	import '@loquix/core/define/define-tool-call-list';
	import '@loquix/core/define/define-uncertainty-marker';
	import '@loquix/core/define/define-suggestion-chips';
	import '@loquix/core/define/define-typing-indicator';
	import '@loquix/core/define/define-welcome-screen';

	const suggestions = [
		{ id: 'write', text: 'Write a launch post', icon: '✍️' },
		{ id: 'summarize', text: 'Summarize a document', icon: '📝' },
		{ id: 'debug', text: 'Debug my code', icon: '⌘' },
		{ id: 'explain', text: 'Explain a concept', icon: '💡' },
	];

	const models = [
		{
			value: 'atlas-pro',
			label: 'Atlas Pro',
			description: 'Best for complex reasoning',
			cost: '$5/MTok',
			group: 'Flagship',
			capabilities: ['reasoning', 'vision', 'code'],
		},
		{
			value: 'atlas-mini',
			label: 'Atlas Mini',
			description: 'Fast and affordable',
			cost: '$0.20/MTok',
			group: 'Fast',
			capabilities: ['chat', 'code'],
		},
		{
			value: 'ember',
			label: 'Ember',
			description: 'Creative writing specialist',
			cost: '$2/MTok',
			group: 'Specialized',
			capabilities: ['writing'],
		},
	];

	const modes = [
		{ value: 'chat', label: 'Chat', icon: '💬', description: 'General conversation' },
		{ value: 'research', label: 'Research', icon: '🔍', description: 'Deep analysis' },
		{ value: 'build', label: 'Build', icon: '⌘', description: 'Code generation' },
	];

	const attachments = [
		{
			id: 'brief',
			filename: 'product-brief.pdf',
			filetype: 'application/pdf',
			size: 245000,
			status: 'complete',
		},
		{
			id: 'data',
			filename: 'research-data.csv',
			filetype: 'csv',
			size: 52000,
			status: 'complete',
		},
		{
			id: 'prototype',
			filename: 'prototype.tsx',
			filetype: 'tsx',
			size: 18400,
			status: 'complete',
		},
		{
			id: 'notes',
			filename: 'interview-notes.md',
			filetype: 'md',
			size: 8600,
			status: 'complete',
		},
	];

	document.querySelectorAll('loquix-suggestion-chips[data-demo]').forEach((element) => {
		(element as HTMLElement & { suggestions: typeof suggestions }).suggestions = suggestions;
	});

	document.querySelectorAll('loquix-follow-up-suggestions[data-demo]').forEach((element) => {
		(element as HTMLElement & { suggestions: typeof suggestions }).suggestions = suggestions;
	});

	document.querySelectorAll('loquix-welcome-screen[data-demo]').forEach((element) => {
		(element as HTMLElement & { suggestions: typeof suggestions }).suggestions = suggestions;
	});

	document.querySelectorAll('loquix-message-attachments[data-demo]').forEach((element) => {
		(element as HTMLElement & { attachments: typeof attachments }).attachments = attachments;
	});

	document.querySelectorAll('loquix-model-selector[data-demo]').forEach((element) => {
		(element as HTMLElement & { models: typeof models }).models = models;
	});

	document.querySelectorAll('loquix-mode-selector[data-demo]').forEach((element) => {
		(element as HTMLElement & { modes: typeof modes }).modes = modes;
	});

	// Some components expose object-valued properties with `attribute: false`
	// (tool-call args, citation source, source lists). Pages declare them as JSON
	// in `data-props` and we assign them once the definitions have loaded.
	document.querySelectorAll<HTMLElement>('[data-props]').forEach((element) => {
		const raw = element.dataset.props;
		if (!raw) return;

		try {
			Object.assign(element, JSON.parse(raw));
		} catch (error) {
			console.error('LivePreview: could not parse data-props', element, error);
		}
	});
</script>
