---
const { siteTitle } = Astro.locals.starlightRoute;
---

<a href="https://loquix.dev/" class="site-title sl-flex" aria-label={`${siteTitle} home`}>
	<span translate="no">{siteTitle}</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			min-width: 0;
			color: var(--sl-color-text-accent);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			text-decoration: none;
			white-space: nowrap;
		}

		span {
			overflow: hidden;
		}
	}
</style>
